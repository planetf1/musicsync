# shellcheck shell=bash
# shellcheck disable=SC2148,SC2034
# dotenv example file for MusicSync (not a shell script); variables may appear unused here.

# Spotify OAuth
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Use the same value configured in your Spotify app
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# TIDAL integration (default: enabled)
# Set to 'false', '0', or 'no' to disable TIDAL sync
TIDAL_ENABLED=true

# Apple Music integration
# You need an Apple Developer Team + MusicKit key (.p8) to enable this.
APPLE_MUSIC_TEAM_ID=your_apple_team_id
APPLE_MUSIC_KEY_ID=your_apple_key_id
APPLE_MUSIC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Server settings (used by the musicsync CLI)
MUSICSYNC_HOST=127.0.0.1
MUSICSYNC_PORT=8000
# Set to 0 to disable auto-reload
MUSICSYNC_RELOAD=1
